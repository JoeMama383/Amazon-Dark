"function ad7593BusinessNeutralPass(){try{\n"
" if(d.documentElement.getAttribute('data-ad7593-business-card')!=='1'||!d.body)return;\n"
" var els=d.body.querySelectorAll('main,section,article,div,p,h1,h2,h3,h4,h5,h6,span,label');\n"
" for(var i=0;i<els.length&&i<650;i++){\n"
"  var el=els[i],cs=window.getComputedStyle(el);if(!cs)continue;\n"
"  var bg=/rgba?\\((\\d+),\\s*(\\d+),\\s*(\\d+)(?:,\\s*([0-9.]+))?/.exec(cs.backgroundColor||'');\n"
"  if(bg&&(!bg[4]||+bg[4]>.90)&&+bg[1]>210&&+bg[2]>210&&+bg[3]>210&&Math.max(+bg[1],+bg[2],+bg[3])-Math.min(+bg[1],+bg[2],+bg[3])<25){\n"
