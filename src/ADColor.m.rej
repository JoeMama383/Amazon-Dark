--- src/ADColor.m
+++ src/ADColor.m
@@ -66,6 +66,9 @@
 
 static const double AD_MAX_BG_LIGHTNESS = 0.4;
 static const double AD_MIN_FG_LIGHTNESS = 0.55;
+// Ceiling for border output. 0.5 (the upstream value) is mid-grey and glows on a
+// near-black ground; 0.30 stays a visible divider without reading as a white line.
+static const double AD_MAX_BORDER_LIGHTNESS = 0.30;
 
 static ADHSL ADModifyBgHSL(ADHSL in, ADHSL pole) {
     BOOL isDark    = in.l < 0.5;
@@ -130,7 +133,20 @@
         if (isDark) { hx = poleFg.h; sx = poleFg.s; }
         else        { hx = poleBg.h; sx = poleBg.s; }
     }
+    // v5.275: the upstream curve is scale(l, 0,1, 0.5,0.2) -- it maps an ALREADY-DARK
+    // border (l~0.05) UP to 0.485 mid-grey. On our #181a1b ground that reads as a
+    // bright white hairline, which is exactly what the person tab and the Interests
+    // cards were showing (measured b1=0.46-0.49), and why every attempt to darken
+    // those borders got repainted light again on the next pass -- we were fighting
+    // our own engine, and the repaint is what made them flash.
+    //
+    // Borders must never end up LIGHTER than they started on a dark theme. Clamp the
+    // output so a dark input stays dark, and cap the ceiling well under the old 0.5
+    // so a light input lands at a visible-but-quiet divider instead of a glowing one.
     double lx = ADScale(in.l, 0, 1, 0.5, 0.2);
+    if (lx > in.l + 0.06) lx = in.l + 0.06;   // never brighten a dark border
+    if (lx > AD_MAX_BORDER_LIGHTNESS) lx = AD_MAX_BORDER_LIGHTNESS;
+    if (lx < 0.0) lx = 0.0;
     ADHSL o = { hx, sx, lx }; return o;
 }
 
