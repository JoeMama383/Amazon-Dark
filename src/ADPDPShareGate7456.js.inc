"(function(){\n"
"'use strict';\n"
"try{\n"
" var page=document.getElementById('a-page'),pdp=document.getElementById('dp');\n"
" if(!pdp)return {ready:true,reason:'not-pdp'};\n"
" if(document.hidden)return {error:'document-backgrounded'};\n"
" var nonce=String(window.__adPDPGateNonce7456||''),now=Date.now(),s=window.__adPDPGateState7456;\n"
" if(!s||s.nonce!==nonce)s=window.__adPDPGateState7456={nonce:nonce,start:now,quiet:now,clicks:0,lastClick:0};\n"
" // Remove only our old cosmetic suppression. Amazon owns its modal/scroll state.\n"
" var legacy=document.getElementById('ad7403-share-probe-suppress');if(legacy)legacy.remove();\n"
" var containers=document.querySelectorAll('.a-sheet-web-container:not(.aok-hidden)'),share=null,other=false;\n"
" for(var i=0;i<containers.length;i++){\n"
"  var c=containers[i];if(c.querySelector('.ssf-customize-container-one'))share=c;\n"
"  else if(c.querySelector('.a-sheet-web'))other=true;\n"
" }\n"
" var locked=!!(page&&page.classList.contains('a-scroll-disabled'));\n"
" if(other)return {error:'other-modal-open',locked:locked,share:!!share};\n"
" if(share){\n"
"  s.quiet=now;\n"
"  var close=share.querySelector('button.a-sheet-close');\n"
"  if(!close||close.disabled)return {error:'share-close-unavailable',locked:locked};\n"
"  if(s.clicks<3&&(s.clicks===0||now-s.lastClick>=1000)){\n"
"   s.clicks++;s.lastClick=now;close.click();\n"
"   return {ready:false,reason:'stock-share-close',locked:locked,clicks:s.clicks};\n"
"  }\n"
" }\n"
" if(locked)s.quiet=now;\n"
" if(now-s.start>6500&&(locked||share))return {error:'share-unlock-timeout',locked:locked,share:!!share,clicks:s.clicks};\n"
" var root=document.scrollingElement||document.documentElement;\n"
" return {ready:!locked&&!share&&now-s.quiet>=600&&now-s.start>=1400,reason:locked?'waiting-scroll-unlock':share?'waiting-share-dismissal':'settling',locked:locked,share:!!share,clicks:s.clicks,documentHeight:root.scrollHeight,pageHeight:page?page.scrollHeight:0,y:root.scrollTop};\n"
"}catch(e){return {error:'share-gate-exception',name:String(e&&e.name||'Error')};}\n"
