(function(){try{var d=document,p='',r='';try{p=String(location.pathname||'');r=String(d.referrer||'');}catch(_){}var gate=/\/gp\/help\/contact-seller\/contact-seller(?:\.html)?(?:[\/?#]|$)/i;if(!gate.test(p)&&!gate.test(r))return;var s=d.getElementById('ad7562-seller-messaging');if(!s){s=d.createElement('style');s.id='ad7562-seller-messaging';(d.head||d.documentElement||d).appendChild(s);}s.textContent=`@@AD_CSS:ADSellerMessagingThemeJS7562-001.css.in@@`;function mark(){try{var a=d.images||[],n=Math.min(a.length,120);for(var i=0;i<n;i++){var im=a[i],q=im.getBoundingClientRect(),tok=String(im.className||'')+' '+String(im.id||'');if(q.width>=64&&q.height>=64&&q.width<=320&&q.height<=320&&!/(logo|avatar|icon|sprite|smile)/i.test(tok))im.setAttribute('data-ad7562-seller-product-image','1');}}catch(_){}}if(%d){mark();if(d.readyState!=='complete')window.addEventListener('load',mark,{once:true});}}catch(_){}})();