body:has(#checkoutDisplayPage) #loading-spinner-blocker-doc.loading-spinner-blocker,body:has(#checkoutDisplayPage) .loading-spinner-blocker,body:has(#checkoutDisplayPage) .loading-spinner-spp-blocker{background:rgba(0,0,0,.74)!important;opacity:1!important;}body:has(#checkoutDisplayPage) :is(.loading-spinner-inner.loading-spinner-inner-no-box,.loading-spinner-spp-inner){background:#000!important;border-color:#747a7c!important;box-shadow:none!important;}body:has(#checkoutDisplayPage) :is(#loading-spinner-img.loading-spinner-img,.loading-spinner-spp-img){background:#000!important;filter:invert(1) hue-rotate(180deg)!important;-webkit-filter:invert(1) hue-rotate(180deg)!important;mix-blend-mode:normal!important;opacity:1!important;}