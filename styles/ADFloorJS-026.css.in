#sc-page-container #sc-important-message-alert,#sc-page-container #sc-important-message-alert :is(.a-box-inner,.sc-imb-ingress){background:#000!important;}#sc-page-container #sc-important-message-alert .sc-imb-ingress,#sc-page-container #sc-important-message-alert .sc-imb-ingress h4{color:#e8e6e3!important;-webkit-text-fill-color:#e8e6e3!important;}#sc-page-container #sc-important-message-alert .sc-imb-ingress .a-icon-touch-link{border-color:#e8e6e3!important;background-image:none!important;filter:none!important;-webkit-filter:none!important;}