.a-sheet-web:has(.ssf-customize-container-one) .ssf-backend-preview #ssf-preview-container,.a-sheet-web:has(.ssf-customize-container-one) .ssf-html-preview #ssf-img-main-image,.a-sheet-web:has(.ssf-customize-container-one) img[id^=ssf-share-channel-]{filter:brightness(%.3f)!important;-webkit-filter:brightness(%.3f)!important;mix-blend-mode:normal!important;}.a-sheet-web:has(.ssf-customize-container-one) #ssf-img-reviews-stars{filter:none!important;-webkit-filter:none!important;mix-blend-mode:normal!important;}