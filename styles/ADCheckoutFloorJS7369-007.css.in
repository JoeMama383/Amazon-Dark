#checkoutDisplayPage .checkout-byg-mobile-container li.a-carousel-card.a-carousel-card-empty>.a-loading-static{background:#303335!important;border:1px solid #494d4d!important;border-color:#494d4d!important;box-shadow:none!important;filter:none!important;-webkit-filter:none!important;transition:none!important;}#checkoutDisplayPage .checkout-byg-mobile-container li.a-carousel-card.a-carousel-card-empty>.a-loading-static>.a-loading-static-inner{background-color:transparent!important;filter:brightness(0) invert(1) brightness(.62)!important;-webkit-filter:brightness(0) invert(1) brightness(.62)!important;opacity:.72!important;box-shadow:none!important;transition:none!important;}