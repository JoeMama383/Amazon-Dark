:is(.mobile-ad-container,.ape-wrapper,.ape-placement,.ape-feedback),[id^=ape_][id*=_wrapper],[id^=ape_][id*=_Feedback]{background:#000!important;box-shadow:none!important;}:is(.ape-feedback,[id^=ape_][id*=_Feedback]) :is([data-ad-feedback-label-id],[id^=ad-feedback-text-],[id^=af-label-primary-link-],[class*=ad-feedback],[class*=adFeedback]){background:transparent!important;color:#b1aaa0!important;-webkit-text-fill-color:#b1aaa0!important;opacity:1!important;}