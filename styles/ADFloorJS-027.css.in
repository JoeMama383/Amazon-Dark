#sc-page-container .sc-item-actions .sc-share-icon img,#sc-page-container .sc-item-actions .sc-nested-actions-ingress-icon img{filter:brightness(0) invert(1)!important;-webkit-filter:brightness(0) invert(1)!important;}#sc-page-container .sc-item-actions .sc-nested-actions-ingress-icon{background:#303335!important;border-color:#747a7c!important;color:#e8e6e3!important;-webkit-text-fill-color:#e8e6e3!important;}#sc-page-container .sc-item-actions .sc-nested-actions-ingress-icon:is(:active,:focus,:focus-visible){background:#202324!important;border-color:#747a7c!important;}