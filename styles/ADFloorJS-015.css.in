#search#search .smart-refinements-content a.smart-refinement-pill[role=button]{background:#4a4f51!important;border-color:#34383a!important;outline-color:#34383a!important;box-shadow:none!important;color:#fff!important;-webkit-text-fill-color:#fff!important;filter:none!important;-webkit-filter:none!important;}#search#search .smart-refinements-content a.smart-refinement-pill[role=button] :is(span,p,strong,b,em){background:transparent!important;color:#fff!important;-webkit-text-fill-color:#fff!important;filter:none!important;-webkit-filter:none!important;}#search#search .smart-refinements-content{border-top-color:#494d4d!important;border-bottom-color:#494d4d!important;}