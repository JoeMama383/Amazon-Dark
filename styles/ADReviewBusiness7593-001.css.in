html[data-ad7593-business-card="1"] body{background:#000!important;color:#fff!important;color-scheme:dark!important;}
html[data-ad7593-business-card="1"] :is(main,.a-section,.a-cardui,.a-box,.a-box-inner,article,section,[class*=benefit],[class*=offer],[class*=content],[class*=fee]) :not([class*=hero]):not([class*=banner]){border-color:#494d4d!important;box-shadow:none!important;}
/* Opaque neutral light panels are painted by the finite page-owned color pass; branded blue hero stays authored. */
html[data-ad7593-business-card="1"] :is(h1,h2,h3,h4,h5,h6,p,label,strong,b,.a-color-base,[class*=headline],[class*=heading],[class*=description]):not(a):not(:where(a *)):not(.a-color-link):not(.a-color-price):not([class*=rating]):not([class*=star]):not([class*=prime]):not([class*=blue]){color:#fff!important;-webkit-text-fill-color:#fff!important;}
html[data-ad7593-business-card="1"] :is(.a-color-secondary,.a-color-tertiary,[class*=subtext],[class*=secondary]){color:#b1b5b5!important;-webkit-text-fill-color:#b1b5b5!important;}
html[data-ad7593-business-card="1"] :is(a,.a-color-link,[class*=link],[class*=rating],[class*=prime]):not(button){-webkit-text-fill-color:currentColor!important;}
html[data-ad7593-business-card="1"] :is(button,.a-button,.a-button-primary,[role=button]):not(.a-button-input){background:#000!important;background-color:#000!important;background-image:none!important;color:#fff!important;-webkit-text-fill-color:#fff!important;border:1px solid #747a7c!important;box-shadow:none!important;}
