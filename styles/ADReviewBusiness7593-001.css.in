html[data-ad7593-business-card="1"] :is(hr,.a-divider-inner,[class*=divider]){border-color:#494d4d!important;background-color:#494d4d!important;box-shadow:none!important;}
html[data-ad7593-business-card="1"] :is(.a-icon-touch-link,.a-icon-search,.a-icon-chevron,[class*=chevron] svg,[class*=location] svg,[class*=pin] svg){filter:brightness(0) invert(1)!important;-webkit-filter:brightness(0) invert(1)!important;}
html[data-ad7593-business-card="1"] :is(svg [fill="#0F1111" i],svg [fill="black"],svg [fill="#000"]){fill:#fff!important;}