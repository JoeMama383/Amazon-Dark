pui-list-link-item,.pui-list-link-item,.pui-list-link-item-container{background:#000!important;background-color:#000!important;background-image:none!important;box-shadow:none!important;color:#fff!important;-webkit-text-fill-color:#fff!important}pui-divider,.pui-divider{background:#494d4d!important;background-color:#494d4d!important;border-color:#494d4d!important}.pui-text.black-color,.pui-text.base-color,.black-color,.base-color,.white-color{color:#fff!important;-webkit-text-fill-color:#fff!important}.kyanite-nav-logo-img{filter:invert(1) hue-rotate(180deg) brightness(1.15)!important;-webkit-filter:invert(1) hue-rotate(180deg) brightness(1.15)!important}